{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/landing.html" },
    { "source": "/app", "destination": "/frontend/index.html" },
    { "source": "/app.html", "destination": "/frontend/index.html" },
    { "source": "/landing", "destination": "/frontend/landing.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
